# For plain PostgreSQL (Railway, local, etc.), DATABASE_URL and DIRECT_URL can be identical.
# For Neon specifically: DATABASE_URL = the "pooled" connection string (used by the app at
# runtime), DIRECT_URL = the "direct"/unpooled connection string (used only for migrations).
# Both are shown in the Neon dashboard's "Connect" panel.
DATABASE_URL="postgresql://user:password@localhost:5432/sabahportal?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/sabahportal?schema=public"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="change-this-secret-in-production"
